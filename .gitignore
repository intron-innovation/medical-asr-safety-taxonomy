# Ignore large files; .zip, .tar, .wav, .mp3, etc.
*.zip
*.tar
*.tar.gz
*.flac
*.wav
*.mp3

# Audio is hosted in GCS now (see annotation_webapp audio_file URLs) - never
# commit raw session audio to this repo, it blows up clone/pull size.
data/final_audio/

# Ignore Archive files
archive/

# Ignore all subdirectories in /data
data/Primock-57/*
data/us_datasets/*

# Ignore logs and shell scripts
logs/
*.sh
